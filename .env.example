# --- Local testing (no GCP): set LOCAL_STORAGE_PATH, leave GCS_BUCKET unset ---
# LOCAL_STORAGE_PATH=./data
# GCS_PREFIX=csb_analytics

# --- GCP: set GCS_BUCKET, leave LOCAL_STORAGE_PATH unset ---
# GCS_BUCKET=your-bucket
# GCS_PREFIX=csb_analytics

# Optional: GCS HMAC key/secret (leave unset to use default credentials in GCP)
# GCS_KEY=
# GCS_SECRET=

# ETL-only
# SYNC_MODE=incremental
# FULL_REFRESH=false
# START_DATE=2019-01-01
